{
  "name": "shay-skills",
  "version": "1.2.3",
  "private": true,
  "description": "Shay's curated agent skills for practical engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/shay-wong/skills"
  },
  "bin": {
    "install-shay-skills": "scripts/install-skills.mjs"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "install:skills": "node scripts/install-skills.mjs",
    "test:install-skills": "node --test scripts/install-skills.test.mjs",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
